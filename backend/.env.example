# .env.example - MODELO PARA PRODUÇÃO
# ======================================
# Copie este arquivo para .env (local) ou configure no Render

# Configurações do Servidor
PORT=10000
NODE_ENV=production

# MongoDB Atlas (SUBSTITUA PELA SUA URI!)
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@seu-cluster.mongodb.net/kanban_estoque

# Segurança (USE UMA SENHA FORTE!)
JWT_SECRET=use_uma_senha_forte_com_pelo_menos_32_caracteres_aqui
JWT_EXPIRE=7d

# Credenciais Admin (mude a senha!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# Configurações
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info